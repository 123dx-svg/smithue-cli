{
    "name":  "smithue-cli",
    "version":  "0.8.0",
    "type":  "module",
    "main":  "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsc -p tsconfig.build.json --watch"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
    "devDependencies":  {
                            "@types/node":  "^20.0.0",
                            "typescript":  "^5.3.0",
                            "vitest":  "^1.0.0"
                        },
    "dependencies":  {
                         "commander":  "^15.0.0"
                     },
    "bin":  {
                "smithue-cli":  "./dist/cli.js"
            },
    "engines":  {
                    "node":  "\u003e=18"
                },
    "publishConfig":  {
                          "access":  "public"
                      },
    "license":  "MIT",
    "description":  "CLI tool for controlling Unreal Engine editor via SmithUE plugin",
    "repository":  {
